<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>Help Ticket – Nagarmal Sheonarain Private Limited</title>
<meta name="theme-color" content="#1a1209" />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Jost:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--gold:#b8922a;--gold-light:#e8c96e;--gold-pale:#f7f0dc;--dark:#1a1209;--cream:#fdf8ef;--text:#3a2e1a;--muted:#7a6b52;--border:rgba(184,146,42,.25);--focus:rgba(184,146,42,.7);--white:#fff;--err:#9b2222}
body{font-family:'Jost',sans-serif;background:var(--cream);min-height:100vh;padding:32px 16px 48px;font-size:15px;color:var(--text);
  background-image:radial-gradient(ellipse at 20% 0%,rgba(184,146,42,.08),transparent 60%),radial-gradient(ellipse at 80% 100%,rgba(184,146,42,.06),transparent 60%)}
.card{max-width:560px;margin:0 auto;background:var(--white);border:1px solid var(--border);border-radius:8px;
  box-shadow:0 10px 45px rgba(184,146,42,.14),0 3px 15px rgba(0,0,0,.08);overflow:hidden}
.top-bar{height:5px;background:linear-gradient(90deg,#b8922a,#e8c96e 50%,#b8922a)}
.header{padding:26px 28px 20px;text-align:center;border-bottom:1px solid var(--border)}
.logo{width:72px;height:72px;border-radius:50%;object-fit:contain;background:var(--cream);border:2px solid var(--border);padding:6px;margin-bottom:10px}
.company{font-size:13px;font-weight:600;color:var(--gold);margin-bottom:6px}
h1{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:700;color:var(--dark);line-height:1.15;margin-bottom:6px}
.sub{color:var(--muted);font-size:15px;line-height:1.5}
form{padding:24px 28px 8px}
.f{margin-bottom:18px}
label{display:flex;justify-content:space-between;align-items:baseline;font-size:13px;font-weight:600;color:var(--gold);margin-bottom:6px}
label .opt{font-weight:400;color:var(--muted)}
input[type=text],input[type=tel],textarea{width:100%;padding:0 12px;font:inherit;color:var(--text);background:var(--cream);border:1px solid var(--border);border-radius:5px;outline:none;transition:border-color .25s,box-shadow .25s,background .2s}
input[type=text],input[type=tel]{height:44px}
textarea{padding:10px 12px;min-height:120px;resize:vertical;line-height:1.5}
input:focus,textarea:focus{border-color:var(--focus);background:var(--white);box-shadow:0 0 0 3px rgba(184,146,42,.12)}
.f.bad input,.f.bad textarea{border-color:#e0a0a0;background:#fffafa}
.hint{margin-top:5px;font-size:13px;color:var(--muted);min-height:18px}
.f.bad .hint{color:var(--err)}
.phone-count{font-variant-numeric:tabular-nums}
.drop{display:flex;align-items:center;gap:12px;padding:14px;border:1.5px dashed var(--border);border-radius:6px;background:var(--cream);cursor:pointer;transition:border-color .2s,background .2s}
.drop:hover,.drop:focus-within{border-color:var(--focus);background:var(--white)}
.drop input{position:absolute;opacity:0;width:1px;height:1px}
.drop .ic{flex:none;width:38px;height:38px;border-radius:50%;background:var(--gold-pale);display:grid;place-items:center;color:var(--gold)}
.drop .t{font-size:14px;color:var(--text);word-break:break-all}
.drop .t small{display:block;color:var(--muted);font-size:12.5px;margin-top:2px}
.rm{margin-left:auto;flex:none;background:none;border:none;color:var(--err);font:600 13px 'Jost',sans-serif;cursor:pointer;padding:6px}
.btn{width:100%;height:46px;margin-top:6px;background:var(--dark);color:var(--gold-light);border:1px solid var(--dark);border-radius:5px;font:600 14px 'Jost',sans-serif;letter-spacing:.06em;cursor:pointer;transition:background .2s}
.btn:hover{background:#2a1f0a}
.btn:disabled{opacity:.65;cursor:wait}
.btn:focus-visible,.rm:focus-visible{outline:2px solid var(--gold);outline-offset:2px}
.prog{height:4px;background:var(--gold-pale);border-radius:2px;margin-top:12px;overflow:hidden;display:none}
.prog i{display:block;height:100%;width:40%;background:var(--gold);animation:slide 1.1s ease-in-out infinite}
@keyframes slide{0%{margin-left:-40%}100%{margin-left:100%}}
@media (prefers-reduced-motion:reduce){.prog i{animation:none;width:100%}}
#msg{margin:16px 28px 0;padding:12px 14px;border-radius:5px;font-size:14px;display:none;line-height:1.5}
#msg.err{display:block;background:#fdf2f2;border:1px solid #f5b7b7;color:var(--err)}
.done{padding:34px 28px 30px;text-align:center;display:none}
.done .tick{width:54px;height:54px;border-radius:50%;background:#f0faf4;border:1px solid #9ad6b0;color:#1e6640;display:grid;place-items:center;margin:0 auto 14px}
.done h2{font-family:'Cormorant Garamond',serif;font-size:27px;color:var(--dark);margin-bottom:6px}
.done .id{display:inline-block;margin:10px 0 14px;padding:8px 18px;background:var(--gold-pale);border:1px solid var(--border);border-radius:5px;font-size:20px;font-weight:600;color:var(--dark);letter-spacing:.04em}
.done p{color:var(--muted);line-height:1.5}
.done .btn{width:auto;padding:0 26px;margin-top:20px}
.footer{padding:16px 28px 22px;border-top:1px solid var(--border);margin-top:18px;text-align:center;font-size:13px;color:var(--muted)}
.footer a{color:var(--gold);font-weight:600;text-decoration:none}
@media(max-width:520px){body{padding:14px 8px 36px}form,.header,.footer{padding-left:16px;padding-right:16px}#msg{margin-left:16px;margin-right:16px}h1{font-size:28px}}
</style>
</head>
<body>
<div class="card">
  <div class="top-bar"></div>
  <div class="header">
    <img class="logo" alt="Nagarmal Logo" src="https://www.nagarmal.com/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Flogo.2bc542ae.png&w=256&q=75" onerror="this.style.display='none'">
    <p class="company">Nagarmal Sheonarain Private Limited</p>
    <h1>Help Ticket</h1>
    <p class="sub">Requirement System me koi problem aa rahi hai? Yahan bata dein, hum aapse sampark karenge.</p>
  </div>

  <form id="form" novalidate autocomplete="off">
    <div class="f" id="f-name">
      <label for="name">Aapka naam</label>
      <input type="text" id="name" maxlength="80" placeholder="Poora naam likhein">
      <p class="hint"></p>
    </div>

    <div class="f" id="f-phone">
      <label for="phone">Phone number <span class="opt phone-count" id="pc">0/10</span></label>
      <input type="tel" id="phone" inputmode="numeric" maxlength="10" placeholder="10 digit ka mobile number">
      <p class="hint"></p>
    </div>

    <div class="f" id="f-issue">
      <label for="issue">Issue kya hai?</label>
      <textarea id="issue" maxlength="2000" placeholder="Kya problem aa rahi hai, kis page ya store par, aur kya karne par aayi?"></textarea>
      <p class="hint"></p>
    </div>

    <div class="f" id="f-video">
      <label for="video">Video <span class="opt">optional</span></label>
      <label class="drop" for="video" style="margin:0;color:inherit;font-weight:400">
        <span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="14" height="14" rx="2"/><path d="M22 8l-6 4 6 4V8z"/></svg></span>
        <span class="t" id="vt">Screen recording ya video chunein<small>Zyada se zyada 25 MB</small></span>
        <button type="button" class="rm" id="rm" hidden>Hatayein</button>
        <input type="file" id="video" accept="video/*">
      </label>
      <p class="hint"></p>
    </div>

    <button class="btn" id="send" type="submit">Ticket bhejein</button>
    <div class="prog" id="prog"><i></i></div>
  </form>
  <div id="msg" role="alert"></div>

  <div class="done" id="done">
    <div class="tick"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg></div>
    <h2>Ticket bhej diya gaya</h2>
    <div class="id" id="tid"></div>
    <p>Is ticket number ko sambhal kar rakhein. Hum jald hi aapke number par sampark karenge.</p>
    <button class="btn" id="again" type="button">Naya ticket</button>
  </div>

  <div class="footer"><strong style="color:var(--gold)">Nagarmal Sheonarain Private Limited</strong> &nbsp;|&nbsp; <a href="https://nagarmal.com/" target="_blank" rel="noopener">nagarmal.com</a></div>
</div>

<script>
// Apps Script ko Web app deploy karke jo URL mile (…/exec), use yahan paste karein
const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbwmQlT4l0EgaI6lB19pqudrJS2F17zhqVxcs0Fs8V7O_LsRTR9xW8Xu91nQs8RPbMhu/exec';
const MAX_MB = 25;

const $ = id => document.getElementById(id);
let file = null;

function setErr(id, text) {
  const f = $('f-' + id);
  f.classList.toggle('bad', !!text);
  f.querySelector('.hint').textContent = text || '';
  return !text;
}

// Phone: sirf digits, max 10
$('phone').addEventListener('input', e => {
  e.target.value = e.target.value.replace(/\D/g, '').slice(0, 10);
  $('pc').textContent = e.target.value.length + '/10';
  if ($('f-phone').classList.contains('bad')) checkPhone();
});

const checkName  = () => setErr('name',  $('name').value.trim() ? '' : 'Apna naam likhein');
const checkPhone = () => {
  const n = $('phone').value.length;
  return setErr('phone', n === 10 ? '' : (n === 0 ? 'Phone number likhein' : 'Number poora 10 digit ka hona chahiye (abhi ' + n + ' digit hain)'));
};
const checkIssue = () => setErr('issue', $('issue').value.trim() ? '' : 'Issue likhein');

$('name').addEventListener('input', () => $('f-name').classList.contains('bad') && checkName());
$('issue').addEventListener('input', () => $('f-issue').classList.contains('bad') && checkIssue());

const size = b => b > 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB';

function showFile() {
  $('vt').innerHTML = file
    ? '<span></span><small></small>'
    : 'Screen recording ya video chunein<small>Zyada se zyada ' + MAX_MB + ' MB</small>';
  if (file) {
    $('vt').firstChild.textContent = file.name;
    $('vt').querySelector('small').textContent = size(file.size);
  }
  $('rm').hidden = !file;
}

$('video').addEventListener('change', e => {
  const f = e.target.files[0];
  if (!f) return;
  if (!f.type.startsWith('video/')) { file = null; showFile(); setErr('video', 'Sirf video file chunein'); e.target.value = ''; return; }
  if (f.size > MAX_MB * 1048576) { file = null; showFile(); setErr('video', 'Video ' + MAX_MB + ' MB se chhota hona chahiye (yeh ' + size(f.size) + ' ka hai)'); e.target.value = ''; return; }
  file = f; setErr('video', ''); showFile();
});
$('rm').addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); file = null; $('video').value = ''; setErr('video', ''); showFile(); });

const toBase64 = f => new Promise((res, rej) => {
  const r = new FileReader();
  r.onload = () => res(String(r.result).split(',')[1]);
  r.onerror = () => rej(new Error('Video padhne me dikkat aayi'));
  r.readAsDataURL(f);
});

function showErr(t) { const m = $('msg'); m.textContent = t; m.className = t ? 'err' : ''; }

$('form').addEventListener('submit', async e => {
  e.preventDefault();
  showErr('');
  const ok = [checkName(), checkPhone(), checkIssue()].every(Boolean);
  if (!ok) { document.querySelector('.f.bad input, .f.bad textarea').focus(); return; }
  if (SCRIPT_URL.startsWith('PASTE_')) return showErr('SCRIPT_URL abhi set nahi hai. index.html me Apps Script ka Web app URL paste karein.');

  const btn = $('send');
  btn.disabled = true; btn.textContent = file ? 'Video upload ho raha hai…' : 'Bhej rahe hain…';
  $('prog').style.display = 'block';

  try {
    const payload = { name: $('name').value.trim(), phone: $('phone').value, issue: $('issue').value.trim() };
    if (file) payload.video = { name: file.name, type: file.type, data: await toBase64(file) };

    // text/plain rakha hai taaki browser preflight (CORS) request na bheje
    const r = await fetch(SCRIPT_URL, { method: 'POST', headers: { 'Content-Type': 'text/plain;charset=utf-8' }, body: JSON.stringify(payload) });
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'Ticket nahi ban paaya');

    $('tid').textContent = j.ticketId;
    $('form').style.display = 'none'; $('msg').className = '';
    $('done').style.display = 'block';
  } catch (err) {
    showErr(err.message === 'Failed to fetch' ? 'Internet ya server se connection nahi ho paaya. Dobara try karein.' : err.message);
  }
  btn.disabled = false; btn.textContent = 'Ticket bhejein';
  $('prog').style.display = 'none';
});

$('again').addEventListener('click', () => {
  $('form').reset(); file = null; showFile(); $('pc').textContent = '0/10';
  ['name', 'phone', 'issue', 'video'].forEach(i => setErr(i, ''));
  $('done').style.display = 'none'; $('form').style.display = 'block';
});
</script>
</body>
</html>
